{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "skipLibCheck": true,

    "verbatimModuleSyntax": false,

    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src"]
}